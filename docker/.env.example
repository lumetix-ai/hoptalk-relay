APP_BUILD_TARGET=app-development

PYTHON_VERSION=3.14.7
NODE_VERSION=24

HTTP_PORT=8081
HTTPS_PORT=8444

# The address the admin panel is opened at. The TLS certificate is issued for it, and the
# panel answers requests for it, for 127.0.0.1 and for localhost only. Leave it empty to
# detect the LAN address of this machine.
SERVER_ADDRESS=

# The database is reachable only inside the Compose network. "make setup" fills the
# password in when it is empty.
POSTGRES_DB=hoptalk_relay
POSTGRES_USER=hoptalk_relay
POSTGRES_PASSWORD=

# ----------------------------------------------------------------------------------------------------------------------
# How the relay worker reaches the MeshCore node
#
# "tcp" on a Mac: Docker Desktop cannot pass a USB device into a container, so
# "make serial-bridge" exposes the node on 127.0.0.1:5055 and the worker connects to it
# through host.docker.internal. "serial" on Linux: docker-compose.serial-device.yml gives
# the relay service the host's /dev and the tty group, and the worker opens the udev
# symlink below directly.
# ----------------------------------------------------------------------------------------------------------------------

MESHCORE_TRANSPORT=tcp
MESHCORE_TCP_HOST=host.docker.internal
MESHCORE_TCP_PORT=5055

MESHCORE_SERIAL_DEVICE=/dev/meshcore-node
# The group that owns /dev/ttyACM* on the host: stat -c %g /dev/ttyACM0
SERIAL_DEVICE_GID=20
