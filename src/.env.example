# ----------------------------------------------------------------------------------------------------------------------
# HopTalk Relay application settings
#
# The application parses this file itself, without "$" expansion, so an Argon2 hash goes
# in as it is, without quotes. A real environment variable of the same name wins over a
# line here. Both the panel and the relay worker refuse to start while a value below is
# missing or out of range, and the error names the variable. A change takes effect after
# "make container-restart".
# ----------------------------------------------------------------------------------------------------------------------

# "make setup" writes one when this is empty; "make generate-secret-key" prints a new one.
# Changing it signs the operator out.
SECRET_KEY=

# The only operator of the admin panel. "make generate-admin-password" prints the hash line.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# The zone the panel shows timestamps in: any IANA identifier, such as Australia/Melbourne.
# The database always stores UTC.
TIME_ZONE=UTC

# ----------------------------------------------------------------------------------------------------------------------
# Retry strategy: deliveries of messages, read and delivered receipts, and refresh sessions
#
# A round is retried after min(MAXIMUM_PAUSE, INITIAL_PAUSE x MULTIPLIER ^ (attempt - 1))
# seconds. With the defaults a device that never answers sees rounds at 0, 30, 90, 210, 450
# and 930 seconds and is given up after about 25 minutes. A multiplier of 1.0 keeps the
# pause fixed.
# ----------------------------------------------------------------------------------------------------------------------

# 1 to 20
RELAY_RETRY_MAXIMUM_ATTEMPTS=6
# 5 to 3600
RELAY_RETRY_INITIAL_PAUSE_SECONDS=30
# 1.0 to 4.0
RELAY_RETRY_BACKOFF_MULTIPLIER=2.0
# From the initial pause to 86400
RELAY_RETRY_MAXIMUM_PAUSE_SECONDS=600
# 0 to 300. How long a "delivered" receipt is held back, so that a quick read sends only
# the "read" receipt. 0 sends it at once.
RELAY_DELIVERED_RECEIPT_DELAY_SECONDS=15

# ----------------------------------------------------------------------------------------------------------------------
# Pacing of the relay node
# ----------------------------------------------------------------------------------------------------------------------

# 2 to 6. Packets that may wait for a firmware acknowledgement at once; one place is kept
# for replies.
RELAY_MAXIMUM_PACKETS_AWAITING_NODE_ACKNOWLEDGEMENT=4
# 1.0 to 30.0
RELAY_MINIMUM_SECONDS_BETWEEN_SENDS=2.0
# 1 to 10. Deliveries in progress to one device, new messages and refreshes together.
RELAY_MAXIMUM_ACTIVE_DELIVERIES_PER_DEVICE=3

# ----------------------------------------------------------------------------------------------------------------------
# Retention and pairing
# ----------------------------------------------------------------------------------------------------------------------

# 1 to 3650. How long the traffic log (received and sent direct messages) is kept.
RELAY_LOG_RETENTION_DAYS=30
# 60 to 600, and 10 to 120: the defaults of the pairing form.
RELAY_PAIRING_DEFAULT_DURATION_SECONDS=120
RELAY_PAIRING_DEFAULT_ADVERT_INTERVAL_SECONDS=30
